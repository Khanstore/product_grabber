<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="import_product_log_view_list" model="ir.ui.view">
            <field name="name">import.product.log.list</field>
            <field name="model">import.product.log</field>
            <field name="arch" type="xml">
                <list default_order="create_date desc" create="false" edit="false">
                    <field name="create_date" string="Date"/>
                    <field name="status"/>
                    <field name="source_domain"/>
                    <field name="source_url"/>
                    <field name="product_id"/>
                    <field name="user_id"/>
                    <field name="message"/>
                </list>
            </field>
        </record>

        <record id="import_product_log_view_graph" model="ir.ui.view">
            <field name="name">import.product.log.graph</field>
            <field name="model">import.product.log</field>
            <field name="arch" type="xml">
                <graph string="Imports Over Time" type="bar">
                    <field name="create_date" interval="day"/>
                    <field name="status"/>
                </graph>
            </field>
        </record>

        <record id="import_product_log_view_pivot" model="ir.ui.view">
            <field name="name">import.product.log.pivot</field>
            <field name="model">import.product.log</field>
            <field name="arch" type="xml">
                <pivot string="Import Summary">
                    <field name="source_domain" type="row"/>
                    <field name="status" type="col"/>
                </pivot>
            </field>
        </record>

        <record id="import_product_log_view_form" model="ir.ui.view">
            <field name="name">import.product.log.form</field>
            <field name="model">import.product.log</field>
            <field name="arch" type="xml">
                <form create="false" edit="false">
                    <sheet>
                        <group>
                            <field name="source_url"/>
                            <field name="source_domain"/>
                            <field name="status"/>
                            <field name="product_id"/>
                            <field name="user_id"/>
                            <field name="create_date"/>
                        </group>
                        <field name="message"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_import_product_log" model="ir.actions.act_window">
            <field name="name">Import Log</field>
            <field name="res_model">import.product.log</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_import_product_dashboard" model="ir.actions.act_window">
            <field name="name">Import Dashboard</field>
            <field name="res_model">import.product.log</field>
            <field name="view_mode">graph,pivot,list,form</field>
            <field name="context">{'search_default_this_month': 1}</field>
        </record>

        <record id="import_product_log_search" model="ir.ui.view">
            <field name="name">import.product.log.search</field>
            <field name="model">import.product.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="source_domain"/>
                    <field name="source_url"/>
                    <field name="product_id"/>
                    <filter string="This Month" name="this_month"
                            domain="[('create_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Created" name="status_created" domain="[('status', '=', 'created')]"/>
                    <filter string="Updated" name="status_updated" domain="[('status', '=', 'updated')]"/>
                    <filter string="Duplicate" name="status_duplicate" domain="[('status', '=', 'duplicate')]"/>
                    <filter string="Error" name="status_error" domain="[('status', '=', 'error')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Source Site" name="group_source" context="{'group_by': 'source_domain'}"/>
                        <filter string="Day" name="group_day" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
