<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Adds a "Refresh from Source" button to the product form so a
            single product can be re-scraped on demand (in addition to the
            scheduled cron in data/ir_cron.xml). Targets the standard
            button_box, which is present on the stock product.template
            form; if book_shop heavily customises that form and this
            xpath doesn't match, this file can simply be removed from
            __manifest__.py without affecting the rest of the module.
        -->
        <record id="product_template_form_refresh_button" model="ir.ui.view">
            <field name="name">product.template.form.refresh.from.source</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_refresh_from_source"
                            type="object"
                            string="Refresh from Source"
                            icon="fa-refresh"
                            invisible="not publisher_link"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
